# ==========================================
# 1. 가상환경 & Python / OS 기본
# ==========================================
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db

# ==========================================
# 2. 보안 및 환경 변수 / 인증 키 (절대 커밋 금지)
# ==========================================
.env
.env.*
*.json
# dbt 프로필 파일이 프로젝트 내에 생성될 경우 대비
**/profiles.yml

# ==========================================
# 3. 데이터 파일 및 캐시 (dbt seeds 폴더는 예외 처리)
# ==========================================
# # 3. 데이터 파일 및 캐시 (dbt seeds 폴더는 예외 처리)
# ==========================================
# 1. data 폴더 바로 아래 파일 무시
data/*
!data/.gitkeep
!data/*/

# 2. data 하위 폴더(raw, processed 등) 내부의 파일 무시
data/*/*
!data/*/.gitkeep

# dbt seed 폴더 내 CSV는 추적 허용
*.csv
!**/seeds/*.csv
*.parquet

# ==========================================
# 4. dbt 빌드 결과물 & 패키지 & 로그 (모든 하위 경로 포함)
# ==========================================
**/target/
**/dbt_packages/
**/logs/
**/.dbt/
**/dbt_modules/

# ==========================================
# 5. IDE 및 주피터 노트북 캐시
# ==========================================
.ipynb_checkpoints/
.vscode/
.idea/

# ==========================================
# 6. 기타
# ==========================================
secret/
output_parquet/